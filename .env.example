# Copy to .env at the repo root. Never paste these values into a chat or a Switch room.
# Everything is optional except where noted — missing pieces show up on Studio → Connections.

# --- Switch (Publisher = custom agent in the approvals and work rooms) ---
# Local server run by Switch Console: filled in by `npm run switch:register -- --local`.
SWITCH_BRIDGE_URL=http://127.0.0.1:60894
# Hosted Switch only: a registration key from its admin (local servers don't need this).
SWITCH_REGISTRATION_KEY=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=

# --- Telegram previews ---
# The SAME bot token you gave Switch Console (BotFather). Used only to send the image/slides/video
# to the client's approval group — Switch relays text only.
TELEGRAM_BOT_TOKEN=

# --- Postiz (publishing to Instagram / Facebook / LinkedIn / YouTube) ---
# Self-hosted Docker: http://localhost:4007/api/public/v1 · Postiz cloud: https://api.postiz.com/public/v1
POSTIZ_API_URL=http://localhost:4007/api/public/v1
# Postiz → Settings → Public API. Empty = dry-run (approvals recorded, nothing posted).
POSTIZ_API_KEY=

# --- Google Drive (reference images + archive of approved media) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized redirect URI: http://localhost:3000/api/drive/callback
#   Enable "Google Drive API"; OAuth consent screen in Testing with your Gmail as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pre-selects this account on Google's sign-in screen (optional).
GOOGLE_DRIVE_ACCOUNT=

# --- Reel / story voiceover ---
# Sarvam AI (dashboard.sarvam.ai → API keys). Empty → videos render without voice.
SARVAM_API_KEY=

# --- Publisher service ---
PUBLISHER_PORT=4100
# Shared secret callers must send as `x-bolo-secret` (Postiz webhook, test relay). Use a long random value.
PUBLISHER_WEBHOOK_SECRET=change-me

# --- Web app ---
# Where the studio runs (bolo CLI renders through it; Google redirect uses it).
BOLO_WEB_URL=http://localhost:3000
# Signs session cookies. Empty → a random secret is created in data/auth-secret.
# AUTH_SECRET=
# Where the JSON store lives. Defaults to <repo>/data
# BOLO_DATA_DIR=
