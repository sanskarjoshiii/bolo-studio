# Copy to .env at the repo root. Never paste these values into a chat or a Switch room.
# These are PLATFORM settings — set once by the Bolo Studio admin. Clients never see them: they
# connect their own Telegram, Instagram/Facebook, LinkedIn, Drive, Sarvam and AI key in
# Studio → Connections. Anything missing shows on the admin-only Studio → Platform page.

# --- Web app ---
# The studio's public address (OAuth redirects and links use it).
BOLO_WEB_URL=http://localhost:3000
# Public https address Instagram downloads media from (production: same as BOLO_WEB_URL).
# BOLO_PUBLIC_URL=
# Signs session cookies. Empty → a random secret is created in data/auth-secret.
# AUTH_SECRET=
# Encrypts the keys and tokens clients connect (32 random bytes as 64 hex characters).
# Empty → derived from the session secret.
# BOLO_ENCRYPTION_KEY=
# Where the data lives (posts, accounts, media). Defaults to <repo>/data.
# BOLO_DATA_DIR=
# --- Database: MongoDB Atlas ---
# Atlas → your cluster → Connect → Drivers (docs/deploy-aws.md step 2). Empty → files in data/.
# Locally against Atlas, use MONGODB_DB=bolo_studio_dev so you never touch real clients' data.
MONGODB_URI=
MONGODB_DB=bolo_studio

# --- Telegram bot (client previews) ---
# The SAME bot Switch Console bridges. Switch reads the clients' replies ("approve #ref") and the
# Publisher agent acts on them; Bolo only uses this token to SEND the images and videos.
TELEGRAM_BOT_TOKEN=
# With Switch set up, Bolo never reads this bot (off). Without Switch: poll (Bolo's own buttons).
# TELEGRAM_UPDATES=off
# TELEGRAM_WEBHOOK_SECRET=

# --- Facebook & Instagram (clients click "Continue with Facebook") ---
# developers.facebook.com → My Apps → Create app (Business) → add "Facebook Login for Business".
# Valid OAuth redirect URI: <BOLO_WEB_URL>/api/connect/meta/callback
META_APP_ID=
META_APP_SECRET=
# Business apps: Facebook Login for Business → Configurations → the configuration's ID
META_CONFIG_ID=
# META_GRAPH_VERSION=v23.0

# --- LinkedIn (clients click "Continue with LinkedIn") ---
# linkedin.com/developers → Create app → Products: "Sign In with LinkedIn using OpenID Connect"
# and "Share on LinkedIn". Redirect URL: <BOLO_WEB_URL>/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Google Drive (clients click "Connect Google Drive"; every design is saved to their Drive) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized redirect URI: <BOLO_WEB_URL>/api/drive/callback · enable "Google Drive API"
#   OAuth consent screen scopes: .../auth/drive.file, openid, email (no restricted scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Agency fallbacks (your own demo companies; clients use their own keys) ---
# Sarvam AI voiceovers when a company hasn't connected its own key.
SARVAM_API_KEY=
# Companies with no AI key connected use this machine's Claude Code login. "off" on servers
# where only clients' own keys should be used.
# BOLO_LOCAL_CLAUDE=off
# CLAUDE_BIN=          path to claude / claude.exe if it isn't found automatically
# CLAUDE_MODEL=        e.g. sonnet or opus; empty → Claude Code's default

# --- Switch (admin only: your content agents and rooms) ---
# Local server run by Switch Console: filled in by `npm run switch:register -- --local`.
SWITCH_BRIDGE_URL=http://127.0.0.1:60894
# Hosted Switch only: a registration key from its admin (local servers don't need this).
SWITCH_REGISTRATION_KEY=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
PUBLISHER_PORT=4100
# Shared secret callers must send as `x-bolo-secret` (Postiz webhook, test relay). Use a long random value.
PUBLISHER_WEBHOOK_SECRET=change-me

# --- Postiz (admin only, optional: channels a client hasn't connected directly, e.g. YouTube) ---
# Self-hosted Docker: http://localhost:4007/api/public/v1 · Postiz cloud: https://api.postiz.com/public/v1
POSTIZ_API_URL=http://localhost:4007/api/public/v1
POSTIZ_API_KEY=
